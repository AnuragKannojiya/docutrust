# DocuTrust environment variables
# Copy to .env and fill in real values.

# ---- Required for production paths ----
OPENAI_API_KEY=sk-...

# ---- MongoDB ----
# Local dev: leave as the default below.
# Production / Atlas: replace with your Atlas connection string.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=docutrust

# ---- Vector store backend ----
# One of: faiss (local file-backed) | atlas (Atlas Vector Search)
VECTOR_BACKEND=faiss

# Required when VECTOR_BACKEND=atlas
ATLAS_VECTOR_INDEX=vector_index
ATLAS_VECTOR_DIM=1536

# Path for the local FAISS index (dev only)
FAISS_INDEX_PATH=./data/faiss

# ---- LLM and embeddings ----
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIM=1536

# ---- Grader ----
GRADER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
GRADER_THRESHOLD=0.55
GRADER_DEVICE=cpu

# ---- Retrieval ----
RETRIEVAL_K=8

# ---- Web fallback ----
WEB_DOMAINS_ALLOWLIST=sec.gov,europa.eu,nist.gov,iso.org,fas.org,bis.doc.gov
WEB_MAX_RESULTS=5
